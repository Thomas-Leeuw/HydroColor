<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:HydroColor.ViewModels"
             xmlns:models="clr-namespace:HydroColor.Models"
             xmlns:strings="clr-namespace:HydroColor.Resources.Strings"
             xmlns:views="clr-namespace:HydroColor.Views"
             x:Class="HydroColor.Views.LibraryView"
             BackgroundColor="Black"                         
             x:DataType="viewmodels:LibraryViewModel"
             Shell.NavBarIsVisible="False"
             Title=""
             x:Name="LibraryContentPage">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
        EventName="Appearing"
        BindingContext="{Binding Path=BindingContext, Source={x:Reference LibraryContentPage}, x:DataType=views:LibraryView}"
        Command="{Binding ViewAppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="auto,*,auto,auto" BackgroundColor="Black">

        <!-- Hint shown only when there are measurements in the list -->
        <Label Grid.Row="0"
               Text="{x:Static strings:Strings.Library_SwipeToDeleteHint}"
               FontSize="14"
               TextColor="LightGray"
               VerticalOptions="Center"
               HorizontalOptions="Start"
               Margin="10,5"
               IsVisible="{Binding MeasurementsExist}"/>

        <Button Grid.Row="0"
                Text="{x:Static strings:Strings.Library_EmailDataFileButton}"
                HorizontalOptions="End"
                FontSize="12"
                Margin="5"
                Command="{Binding EmailDataFileCommand}"/>

        <!-- Swipe a row left to show its Delete button -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding DataLibraryItems}"
                        BackgroundColor="Black"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DataLibraryItem">
                    <SwipeView BackgroundColor="Black">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="{x:Static strings:Strings.Library_DeleteButton}"
                                           BackgroundColor="Red"
                                           Command="{Binding DeleteItemCommand, Source={RelativeSource AncestorType={x:Type viewmodels:LibraryViewModel}}, x:DataType=viewmodels:LibraryViewModel}"
                                           CommandParameter="{Binding}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <!-- One row: 74 for the content plus a 1 pixel separator line -->
                        <Grid RowDefinitions="74,1" BackgroundColor="Black">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding ItemTappedCommand, Source={RelativeSource AncestorType={x:Type viewmodels:LibraryViewModel}}, x:DataType=viewmodels:LibraryViewModel}"
                                    CommandParameter="{Binding}"/>
                            </Grid.GestureRecognizers>

                            <Grid Grid.Row="0" ColumnDefinitions="auto,*,auto,auto" ColumnSpacing="10" Padding="10,6">

                                <!-- The water photo, with rounded corners -->
                                <Border Grid.Column="0" WidthRequest="47" HeightRequest="62" StrokeThickness="0" Padding="0"
                                        Background="#1C1C1E" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6"/>
                                    </Border.StrokeShape>
                                    <Image Source="{Binding WaterImageURI}" Aspect="AspectFill"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding MeasurementName}" FontFamily="OpenSansSemibold" FontSize="17"
                                           TextColor="White" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding LocalTimestamp, StringFormat='{}{0:g}'}" FontSize="14" TextColor="LightGray"/>
                                </VerticalStackLayout>

                                <!-- Turbidity of the measurement; empty if it could not be read -->
                                <Label Grid.Column="2" Text="{Binding TurbidityText}" FontFamily="OpenSansSemibold" FontSize="16"
                                       TextColor="White" VerticalOptions="Center"/>

                                <Image Grid.Column="3" Source="right_arrow.png" HeightRequest="15" Aspect="AspectFit" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView Grid.Row="1" Color="#3A3A3C" Margin="10,0"/>
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Text="{x:Static strings:Strings.Library_NoMeasurements}" 
               Grid.Row="1"
               HorizontalOptions="Center"
               Margin="20"
               FontSize="16"
               IsVisible="{Binding MeasurementsExist, Converter={StaticResource InvertedBoolConverter}}"/>

        <!-- Shown only when some lines in the data file could not be read -->
        <Label
            Text="{Binding UnreadableMeasurementsText}"
            VerticalOptions="End"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Grid.Row="2"
            TextColor="Yellow"
            TextDecorations="Underline"
            Margin="5"
            IsVisible="{Binding HasUnreadableMeasurements}">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding UnreadableMeasurementsCommand}"/>
            </Label.GestureRecognizers>
        </Label>

        <Label
            Text="{x:Static strings:Strings.Library_MissingMeasurementsLink}"
            VerticalOptions="End"
            HorizontalOptions="Center"
            Grid.Row="3"
            TextColor="LightGray"
            TextDecorations="Underline"
            Margin="5">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding MissingMeasurementsCommand}"/>
            </Label.GestureRecognizers>
        </Label>

    </Grid>

</ContentPage>