<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:HydroColor.ViewModels"
             xmlns:converters="clr-namespace:HydroColor.Converters"
             xmlns:strings="clr-namespace:HydroColor.Resources.Strings"
             xmlns:controls="clr-namespace:HydroColor.Controls"
             x:DataType="viewmodels:DataViewModel"
             x:Class="HydroColor.Views.DataView"
             BackgroundColor="Black"
             Shell.TabBarIsVisible="false"
             Shell.NavBarIsVisible="false"
             Title="{Binding ProcMeas.MeasurementName}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding BackButtonCommand}"/>
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CameraBoxOverlayWidthConverter x:Key="CameraBoxOverlayWidthConverter"/>
            <converters:PhotoHeightConverter x:Key="PhotoHeightConverter"/>
            <converters:ProductStringWithUncertainityConverter x:Key="ProductStringWithUncertainity"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- The page draws its own header (back arrow and title); the system navigation bar is hidden -->
    <Grid RowDefinitions="auto,*" BackgroundColor="Black">
    <controls:PageHeader Grid.Row="0"
                         Title="{Binding ProcMeas.MeasurementName}"
                         BackCommand="{Binding BackButtonCommand}"/>

    <!-- The page scrolls as a whole when it does not fit on the screen -->
    <ScrollView Grid.Row="1" BackgroundColor="Black">
        <VerticalStackLayout Padding="12,6,12,12" Spacing="14">

            <!-- When and where -->
            <Grid ColumnDefinitions="*,auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="6">
                    <Label FontSize="15" FontFamily="OpenSansSemibold" TextColor="White" Text="{Binding ProcMeas.WaterImageData.LocalTimeStamp, StringFormat='{}{0:d}'}"/>
                    <Label FontSize="15" FontFamily="OpenSansSemibold" TextColor="White" Text="{Binding ProcMeas.WaterImageData.LocalTimeStamp, StringFormat='{}{0:t}'}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="4">
                    <Label FontSize="15" FontFamily="OpenSansSemibold" TextColor="White" Text="{Binding ProcMeas.WaterImageData.ImageLocation.Latitude, StringFormat='{}{0:0.00000},'}"/>
                    <Label FontSize="15" FontFamily="OpenSansSemibold" TextColor="White" Text="{Binding ProcMeas.WaterImageData.ImageLocation.Longitude, StringFormat='{}{0:0.00000}'}"/>
                </HorizontalStackLayout>
            </Grid>

            <!-- The three water quality results -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">

                <Border Grid.Column="0" Background="#1C1C1E" Stroke="#3A3A3C" StrokeThickness="1" Padding="6,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{x:Static strings:Strings.Data_CardTurbidityTitle}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="{Binding TurbidityText}"
                               FontSize="19" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="{x:Static strings:Strings.Data_TableTurbidityUnits}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Background="#1C1C1E" Stroke="#3A3A3C" StrokeThickness="1" Padding="6,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{x:Static strings:Strings.Data_CardSPMTitle}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="{Binding SPMText}"
                               FontSize="19" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="{x:Static strings:Strings.Data_TableSuspendedParticulateMatterUnits}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" Background="#1C1C1E" Stroke="#3A3A3C" StrokeThickness="1" Padding="6,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{x:Static strings:Strings.Data_CardBackscatterTitle}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="{Binding BackscatterText}"
                               FontSize="19" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="{x:Static strings:Strings.Data_CardBackscatterUnits}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Reflectance chart -->
            <VerticalStackLayout Spacing="6">
                <Label Text="{x:Static strings:Strings.Data_ReflectanceChartTitle}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="White"/>

                <!-- One column per color: the bar with its value above it. Sized in the view model. -->
                <Grid ColumnDefinitions="*,*,*" HeightRequest="{Binding BarChartHeight}">

                    <BoxView Grid.Column="0" Color="#4F8DF7" CornerRadius="6,6,0,0" Margin="18,0"
                             VerticalOptions="End" HeightRequest="{Binding BlueBar.BarHeight}"/>
                    <Label Grid.Column="0" Text="{Binding BlueBar.Text}" FontSize="14" FontFamily="OpenSansSemibold" HorizontalOptions="Center"
                           VerticalOptions="End" Margin="{Binding BlueBar.LabelMargin}"/>

                    <BoxView Grid.Column="1" Color="#3DBE6B" CornerRadius="6,6,0,0" Margin="18,0"
                             VerticalOptions="End" HeightRequest="{Binding GreenBar.BarHeight}"/>
                    <Label Grid.Column="1" Text="{Binding GreenBar.Text}" FontSize="14" FontFamily="OpenSansSemibold" HorizontalOptions="Center"
                           VerticalOptions="End" Margin="{Binding GreenBar.LabelMargin}"/>

                    <BoxView Grid.Column="2" Color="#E5534B" CornerRadius="6,6,0,0" Margin="18,0"
                             VerticalOptions="End" HeightRequest="{Binding RedBar.BarHeight}"/>
                    <Label Grid.Column="2" Text="{Binding RedBar.Text}" FontSize="14" FontFamily="OpenSansSemibold" HorizontalOptions="Center"
                           VerticalOptions="End" Margin="{Binding RedBar.LabelMargin}"/>
                </Grid>

                <BoxView Color="#3A3A3C" HeightRequest="1"/>

                <Grid ColumnDefinitions="*,*,*">
                    <Label Grid.Column="0" Text="{x:Static strings:Strings.Data_ReflectanceGraphBlueLabel}" FontSize="16" FontFamily="OpenSansSemibold" HorizontalOptions="Center"/>
                    <Label Grid.Column="1" Text="{x:Static strings:Strings.Data_ReflectanceGraphGreenLabel}" FontSize="16" FontFamily="OpenSansSemibold" HorizontalOptions="Center"/>
                    <Label Grid.Column="2" Text="{x:Static strings:Strings.Data_ReflectanceGraphRedLabel}" FontSize="16" FontFamily="OpenSansSemibold" HorizontalOptions="Center"/>
                </Grid>
            </VerticalStackLayout>

            <!-- The three images. Each tile has the 3:4 shape of the camera images, so its border sits on the
                 edge of the photo. The border is green when the image was taken at the correct angles, white otherwise. -->
            <Grid ColumnDefinitions="*,*,*">

                <Border x:Name="GrayCardTile" Grid.Column="0" Margin="3" Padding="0" Background="Black" StrokeThickness="3"
                        Stroke="{Binding GrayCardImageSquareColor}"
                        HeightRequest="{Binding Source={x:Reference GrayCardTile}, Path=Width, Converter={StaticResource PhotoHeightConverter}, x:DataType='Border'}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid>
                        <Image x:Name="GrayCardImage" Aspect="AspectFill" Source="{Binding GrayCardThumbnailImage}"/>
                        <Label Text="{x:Static strings:Strings.Data_GrayCard}" FontSize="14" FontFamily="OpenSansSemibold" Padding="0,2"
                               BackgroundColor="#99000000" HorizontalTextAlignment="Center" VerticalOptions="End"/>
                    </Grid>
                </Border>

                <!-- The square that was measured -->
                <Border Grid.Column="0"
                        StrokeThickness="{OnPlatform 5, iOS=5, Android=3}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        WidthRequest="{Binding Source={x:Reference GrayCardImage}, Path=Width, Converter={StaticResource CameraBoxOverlayWidthConverter}, x:DataType='Image'}"
                        HeightRequest="{Binding Source={x:Reference GrayCardImage}, Path=Width, Converter={StaticResource CameraBoxOverlayWidthConverter}, x:DataType='Image'}"
                        Stroke="{Binding GrayCardImageSquareColor}"
                        BackgroundColor="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5" />
                    </Border.StrokeShape>
                </Border>

                <Border x:Name="WaterTile" Grid.Column="1" Margin="3" Padding="0" Background="Black" StrokeThickness="3"
                        Stroke="{Binding WaterImageSquareColor}"
                        HeightRequest="{Binding Source={x:Reference WaterTile}, Path=Width, Converter={StaticResource PhotoHeightConverter}, x:DataType='Border'}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid>
                        <Image x:Name="WaterImage" Aspect="AspectFill" Source="{Binding WaterThumbnailImage}"/>
                        <Label Text="{x:Static strings:Strings.Data_Water}" FontSize="14" FontFamily="OpenSansSemibold" Padding="0,2"
                               BackgroundColor="#99000000" HorizontalTextAlignment="Center" VerticalOptions="End"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        StrokeThickness="{OnPlatform 5, iOS=5, Android=3}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        WidthRequest="{Binding Source={x:Reference WaterImage}, Path=Width, Converter={StaticResource CameraBoxOverlayWidthConverter}, x:DataType='Image'}"
                        HeightRequest="{Binding Source={x:Reference WaterImage}, Path=Width, Converter={StaticResource CameraBoxOverlayWidthConverter}, x:DataType='Image'}"
                        Stroke="{Binding WaterImageSquareColor}"
                        BackgroundColor="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5" />
                    </Border.StrokeShape>
                </Border>

                <Border x:Name="SkyTile" Grid.Column="2" Margin="3" Padding="0" Background="Black" StrokeThickness="3"
                        Stroke="{Binding SkyImageSquareColor}"
                        HeightRequest="{Binding Source={x:Reference SkyTile}, Path=Width, Converter={StaticResource PhotoHeightConverter}, x:DataType='Border'}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid>
                        <Image x:Name="SkyImage" Aspect="AspectFill" Source="{Binding SkyThumbnailImage}"/>
                        <Label Text="{x:Static strings:Strings.Data_Sky}" FontSize="14" FontFamily="OpenSansSemibold" Padding="0,2"
                               BackgroundColor="#99000000" HorizontalTextAlignment="Center" VerticalOptions="End"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        StrokeThickness="{OnPlatform 5, iOS=5, Android=3}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        WidthRequest="{Binding Source={x:Reference SkyImage}, Path=Width, Converter={StaticResource CameraBoxOverlayWidthConverter}, x:DataType='Image'}"
                        HeightRequest="{Binding Source={x:Reference SkyImage}, Path=Width, Converter={StaticResource CameraBoxOverlayWidthConverter}, x:DataType='Image'}"
                        Stroke="{Binding SkyImageSquareColor}"
                        BackgroundColor="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5" />
                    </Border.StrokeShape>
                </Border>
            </Grid>

            <!-- Shown only for a measurement just taken in camera diagnostics mode -->
            <Button Text="Camera Diagnostics"
                    FontSize="12"
                    HorizontalOptions="Center"
                    Command="{Binding ShowDiagnosticsCommand}"
                    IsVisible="{Binding HasDiagnostics}"/>

        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
