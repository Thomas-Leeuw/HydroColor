<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:HydroColor.ViewModels"
             xmlns:models="clr-namespace:HydroColor.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:sensors="clr-namespace:Microsoft.Maui.Devices.Sensors;assembly=Microsoft.Maui.Essentials"
             xmlns:converters="clr-namespace:HydroColor.Converters"
             xmlns:strings="clr-namespace:HydroColor.Resources.Strings"
             xmlns:views="clr-namespace:HydroColor.Views"
             x:DataType="viewmodels:CollectDataViewModel"
             x:Class="HydroColor.Views.CollectDataView"
             BackgroundColor="Black"
             Shell.NavBarIsVisible="false"
             Title=""
             x:Name="CollectDataContentPage">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            EventName="Loaded"
            BindingContext="{Binding Path=BindingContext, Source={x:Reference CollectDataContentPage}, x:DataType=views:CollectDataView}"
            Command="{Binding ViewLoadedCommand}"/>
        <toolkit:EventToCommandBehavior
            EventName="Appearing"
            BindingContext="{Binding Path=BindingContext, Source={x:Reference CollectDataContentPage}, x:DataType=views:CollectDataView}"
            Command="{Binding ViewAppearingCommand}"/>
        <toolkit:StatusBarBehavior StatusBarColor="Black" StatusBarStyle="LightContent"/>
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:CameraBoxOverlayWidthConverter x:Key="CameraBoxOverlayWidthConverter"/>
            <converters:PhotoHeightConverter x:Key="PhotoHeightConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="Black">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <Label 
            Text="{Binding Source={x:Static strings:Strings.CollectData_GrayCardDisplayName}, StringFormat='1  {0}', x:DataType=x:String}"
            TextColor="{Binding GrayCardImageSquareColor}"
            FontSize="16"
            Grid.Row="0"
            Grid.Column="0"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

            <Label 
            Text="{Binding Source={x:Static strings:Strings.CollectData_WaterDisplayName}, StringFormat='2  {0}', x:DataType=x:String}"
            TextColor="{Binding WaterImageSquareColor}"
            FontSize="16"
            Grid.Row="0"
            Grid.Column="1"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

            <Label 
            Text="{Binding Source={x:Static strings:Strings.CollectData_SkyDisplayName}, StringFormat='3  {0}', x:DataType=x:String}"
            TextColor="{Binding SkyImageSquareColor}"
            FontSize="16"
            Grid.Row="0"
            Grid.Column="2"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

            <!-- Each tile has the 3:4 shape of the camera images, so its border sits on the edge of the photo -->
            <Border x:Name="GrayCardTile"
                Grid.Row="1"
                Grid.Column="0"
                Margin="3"
                Padding="0"
                Background="Black"
                StrokeThickness="3"
                Stroke="{Binding GrayCardImageSquareColor}"
                HeightRequest="{Binding Source={x:Reference GrayCardTile}, Path=Width, Converter={StaticResource PhotoHeightConverter}, x:DataType='Border'}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <!-- The placeholder icon is shown whole with some padding; a photo fills the tile to its border -->
                <ImageButton
                    x:Name="GrayCardImageButton"
                    Source="{Binding GrayCardThumbnailImage}"
                    BorderWidth="0"
                    Aspect="AspectFit"
                    Padding="10"
                    Command="{Binding CaptureImageTappedCommand}"
                    CommandParameter="{Binding GrayCardImageType}">
                    <ImageButton.Triggers>
                        <DataTrigger TargetType="ImageButton" Binding="{Binding HaveGrayCardData}" Value="True">
                            <Setter Property="Aspect" Value="AspectFill" />
                            <Setter Property="Padding" Value="0" />
                        </DataTrigger>
                    </ImageButton.Triggers>
                </ImageButton>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" 
                StrokeThickness="{OnPlatform 5, iOS=5, Android=3}" 
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                WidthRequest="{Binding Source={x:Reference GrayCardImageButton}, Path=Width, Converter={StaticResource CameraBoxOverlayWidthConverter}, x:DataType='ImageButton'}"
                HeightRequest="{Binding Source={x:Reference GrayCardImageButton}, Path=Width, Converter={StaticResource CameraBoxOverlayWidthConverter}, x:DataType='ImageButton'}"
                BackgroundColor="Transparent"
                Stroke="{Binding GrayCardImageSquareColor}"
                IsVisible="{Binding HaveGrayCardData}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer 
                        Command="{Binding CaptureImageTappedCommand}"
                        CommandParameter="{Binding GrayCardImageType}"/>
                </Border.GestureRecognizers>
            </Border>

            <Border x:Name="WaterTile"
                Grid.Row="1"
                Grid.Column="1"
                Margin="3"
                Padding="0"
                Background="Black"
                StrokeThickness="3"
                Stroke="{Binding WaterImageSquareColor}"
                HeightRequest="{Binding Source={x:Reference WaterTile}, Path=Width, Converter={StaticResource PhotoHeightConverter}, x:DataType='Border'}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <ImageButton
                    x:Name="WaterImageButton"
                    Source="{Binding WaterThumbnailImage}"
                    BorderWidth="0"
                    Aspect="AspectFit"
                    Padding="10"
                    Command="{Binding CaptureImageTappedCommand}"
                    CommandParameter="{Binding WaterImageType}">
                    <ImageButton.Triggers>
                        <DataTrigger TargetType="ImageButton" Binding="{Binding HaveWaterData}" Value="True">
                            <Setter Property="Aspect" Value="AspectFill" />
                            <Setter Property="Padding" Value="0" />
                        </DataTrigger>
                    </ImageButton.Triggers>
                </ImageButton>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" 
                StrokeThickness="{OnPlatform 5, iOS=5, Android=3}" 
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                WidthRequest="{Binding Source={x:Reference WaterImageButton}, Path=Width, Converter={StaticResource CameraBoxOverlayWidthConverter}, x:DataType='ImageButton'}"
                HeightRequest="{Binding Source={x:Reference WaterImageButton}, Path=Width, Converter={StaticResource CameraBoxOverlayWidthConverter}, x:DataType='ImageButton'}"
                BackgroundColor="Transparent"
                Stroke="{Binding WaterImageSquareColor}"
                IsVisible="{Binding HaveWaterData}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer 
                        Command="{Binding CaptureImageTappedCommand}"
                        CommandParameter="{Binding WaterImageType}"/>
                </Border.GestureRecognizers>
            </Border>

            <Border x:Name="SkyTile"
                Grid.Row="1"
                Grid.Column="2"
                Margin="3"
                Padding="0"
                Background="Black"
                StrokeThickness="3"
                Stroke="{Binding SkyImageSquareColor}"
                HeightRequest="{Binding Source={x:Reference SkyTile}, Path=Width, Converter={StaticResource PhotoHeightConverter}, x:DataType='Border'}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <ImageButton
                    x:Name="SkyImageButton"
                    Source="{Binding SkyThumbnailImage}"
                    BorderWidth="0"
                    Aspect="AspectFit"
                    Padding="10"
                    Command="{Binding CaptureImageTappedCommand}"
                    CommandParameter="{Binding SkyImageType}">
                    <ImageButton.Triggers>
                        <DataTrigger TargetType="ImageButton" Binding="{Binding HaveSkyData}" Value="True">
                            <Setter Property="Aspect" Value="AspectFill" />
                            <Setter Property="Padding" Value="0" />
                        </DataTrigger>
                    </ImageButton.Triggers>
                </ImageButton>
            </Border>

            <Border Grid.Row="1" Grid.Column="2" 
                StrokeThickness="{OnPlatform 5, iOS=5, Android=3}" 
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                WidthRequest="{Binding Source={x:Reference SkyImageButton}, Path=Width, Converter={StaticResource CameraBoxOverlayWidthConverter}, x:DataType='ImageButton'}"
                HeightRequest="{Binding Source={x:Reference SkyImageButton}, Path=Width, Converter={StaticResource CameraBoxOverlayWidthConverter}, x:DataType='ImageButton'}"
                BackgroundColor="Transparent"
                Stroke="{Binding SkyImageSquareColor}"
                IsVisible="{Binding HaveSkyData}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer 
                        Command="{Binding CaptureImageTappedCommand}"
                        CommandParameter="{Binding SkyImageType}"/>
                </Border.GestureRecognizers>
            </Border>

            <Grid ColumnDefinitions="auto,*" 
                  Grid.Row="2" 
                  Grid.ColumnSpan="3" 
                  Background="yellow"
                  IsVisible="{Binding SunElevationAngleWarningVisible}">
                <Image Grid.Column="0" 
                           Source="warning_icon.png" 
                           HeightRequest="30" 
                           WidthRequest="30" 
                           Margin="5"/>
                <Label Grid.Column="1" 
                           Text="{x:Static strings:Strings.CollectData_SunElevationWarningBanner}" 
                           FontSize="11" 
                           Margin="5"
                           TextColor="Black"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer 
                        Command="{Binding SunElevationAngleWarningTappedCommand}"/>
                </Grid.GestureRecognizers>
            </Grid>

            <Button
            Text="{x:Static strings:Strings.CollectData_AnalyzeImagesButton}"
            WidthRequest="150"
            Grid.Row="3"
            Grid.ColumnSpan="3"
            Margin="5,12"
            Opacity="{Binding AnalyzeButtonOpacity}"
            Command="{Binding AnalyzeImagesCommand}"/>

            <!-- Reminder shown only while camera diagnostics mode is on -->
            <Label Text="Diagnostics on"
                   Grid.Row="3"
                   Grid.ColumnSpan="3"
                   HorizontalOptions="End"
                   VerticalOptions="Center"
                   Margin="5"
                   FontSize="11"
                   TextColor="Orange"
                   IsVisible="{Binding DiagnosticsOn}"/>

            <!-- Location: tap a coordinate to type a new value; Refresh asks the phone for its position again -->
            <Border Grid.Row="4" Grid.ColumnSpan="3" Margin="10,4" Padding="12,8"
                    Background="#1C1C1E" Stroke="#3A3A3C" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,auto" RowDefinitions="auto,auto" ColumnSpacing="10" RowSpacing="4">

                        <!-- Row 0, left: the coordinates -->
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="16">
                            <Label FontSize="16" FontFamily="OpenSansSemibold">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static strings:Strings.CollectData_LatitudeAbbreviation}" TextColor="LightGray"/>
                                        <Span Text=" "/>
                                        <Span Text="{Binding CurrentLocation.Latitude, StringFormat='{}{0:#,0.00000}'}" TextDecorations="Underline"/>
                                    </FormattedString>
                                </Label.FormattedText>
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding UserInputLatitudeCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <Label FontSize="16" FontFamily="OpenSansSemibold">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static strings:Strings.CollectData_LongitudeAbbreviation}" TextColor="LightGray"/>
                                        <Span Text=" "/>
                                        <Span Text="{Binding CurrentLocation.Longitude, StringFormat='{}{0:#,0.00000}'}" TextDecorations="Underline"/>
                                    </FormattedString>
                                </Label.FormattedText>
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding UserInputLongitudeCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                        <!-- Row 1, left: accuracy of the position, or a message while the phone is finding it -->
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4" VerticalOptions="Center" IsVisible="{Binding CanCheckLocation}">
                            <Label FontSize="13" TextColor="LightGray" Text="{x:Static strings:Strings.CollectData_LocationAccuracy}"/>
                            <Label FontSize="13" TextColor="LightGray" Text="{Binding CurrentLocation.Accuracy, StringFormat='{0:F0} meters'}"/>
                        </HorizontalStackLayout>

                        <Label Grid.Row="1" Grid.Column="0" VerticalOptions="Center"
                               FontSize="13"
                               FontAttributes="Italic"
                               TextColor="LightGray"
                               Text="{x:Static strings:Strings.CollectData_AquiringLocationInProgress}"
                               IsVisible="{Binding CanCheckLocation, Converter={StaticResource InvertedBoolConverter}}"/>

                    <!-- Right: refresh the position, or the spinner while the phone is finding it -->
                    <ImageButton Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                 Source="refresh_icon.png"
                                 WidthRequest="40"
                                 HeightRequest="40"
                                 Padding="8"
                                 CornerRadius="20"
                                 BackgroundColor="#3A3A3C"
                                 VerticalOptions="Center"
                                 SemanticProperties.Description="{x:Static strings:Strings.CollectData_RefreshLocationButton}"
                                 Command="{Binding GetCurrentLocationCommand}"
                                 IsVisible="{Binding CanCheckLocation}"/>

                    <ActivityIndicator Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                       Color="White"
                                       VerticalOptions="Center"
                                       IsRunning="{Binding CanCheckLocation, Converter={StaticResource InvertedBoolConverter}}"
                                       IsVisible="{Binding CanCheckLocation, Converter={StaticResource InvertedBoolConverter}}"/>
                </Grid>
            </Border>

            <maps:Map
                Margin="10"
                Grid.Row="5"
                Grid.ColumnSpan="3"
                x:Name="UserLocationMap" 
                MapType="Satellite"
                ItemsSource="{Binding MapPins}">
                <maps:Map.ItemTemplate>
                <DataTemplate x:DataType="models:MapPinModel">
                        <maps:Pin 
                            Location="{Binding location}"
                            Label=" "/>
                    </DataTemplate>
                </maps:Map.ItemTemplate>
            </maps:Map>
        </Grid>
</ContentPage>